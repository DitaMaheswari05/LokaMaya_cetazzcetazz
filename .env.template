# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lokamaya?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lokamaya

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── OSRM ──────────────────────────────────────────────────────────────────────
OSRM_URL=http://localhost:5000

# ─── Go API Server ─────────────────────────────────────────────────────────────
GO_API_PORT=8080

# ─── AI Microservice (Python — IndoBERT + BGE-M3) ─────────────────────────────
