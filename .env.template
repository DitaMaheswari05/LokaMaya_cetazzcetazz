# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://<USER>:<PASSWORD>@localhost:5432/lokamaya?sslmode=disable
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=lokamaya

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── OSRM ──────────────────────────────────────────────────────────────────────
OSRM_URL=http://localhost:5000

# ─── Go API Server ─────────────────────────────────────────────────────────────
GO_API_PORT=8080

# ─── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET=<RANDOM_32_BYTE_HEX_STRING>
JWT_EXPIRY_HOURS=24
BCRYPT_COST=12

# ─── AI Microservice (Python — IndoBERT + BGE-M3) ─────────────────────────────
AI_SERVICE_URL=http://localhost:8001
EMBEDDING_MODEL=BAAI/bge-m3

# ─── LiteLLM Proxy ─────────────────────────────────────────────────────────────
LITELLM_URL=http://localhost:4000
LITELLM_API_KEY=<LITELLM_API_KEY>

# ─── AI Provider — Google AI Studio (via LiteLLM) ─────────────────────────────
GOOGLE_AI_STUDIO_API_KEY=<GOOGLE_AI_STUDIO_API_KEY>

# ─── MAPID ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPID_API_KEY=<MAPID_API_KEY>